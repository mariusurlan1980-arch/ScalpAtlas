PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/scalp_atlas

# Preferred production identity provider for SCALP ATLAS accounts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional generic identity-provider adapter. Used only when Supabase is not configured.
AUTH_INTROSPECTION_URL=

# URL of the private Google Play / Apple verification adapter.
# The app never receives store secrets.
STORE_VERIFIER_URL=

# Development only. Never use in production.
DEV_USER_ID=
