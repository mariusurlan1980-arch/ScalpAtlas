{
  "expo": {
    "name": "SCALP ATLAS",
    "slug": "scalp-atlas",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.scalpatlas.app",
      "versionCode": 105,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.scalpatlas.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SCALP ATLAS folosește camera pentru analiza graficului afișat pe al doilea dispozitiv."
      }
    },
    "plugins": [
      "expo-camera"
    ],
    "web": {
      "name": "SCALP ATLAS"
    }
  }
}
