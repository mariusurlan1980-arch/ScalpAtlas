{
  "expo": {
    "name": "SCALP ATLAS",
    "slug": "scalp-atlas",
    "version": "0.2.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scalpatlas.app"
    },
    "android": {
      "package": "com.scalpatlas.app",
      "versionCode": 5,
      "permissions": ["CAMERA"],
      "icon": "./assets/app-icon.png"
    },
    "web": {
      "name": "SCALP ATLAS",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SCALP ATLAS folosește fotografia selectată doar pentru analiza graficului.",
          "cameraPermission": "SCALP ATLAS folosește camera pentru a fotografia graficul pe care dorești să îl analizezi.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
