# No secrets are stored in GitHub.
NODE_ENV=development
PORT=8787

PARTNER_LINK_SECRET=
INTERNAL_API_KEY=
PORTAL_BASE_URL=http://localhost:8787

# Routing is OFF unless explicitly enabled.
ENABLE_ROUTING_ENGINE=false
ROUTING_RESPONSE_MINUTES=10
ROUTING_MAX_ATTEMPTS=5
ROUTING_TICK_MS=30000

# Financial automation is independently OFF unless explicitly enabled.
ENABLE_PAYMENT_AUTOMATION=false
FINANCIAL_TICK_MS=30000

# Production partner directory comes from Shopify metaobjects.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Florist offer notifications.
# In development, leave SMTP_HOST empty to log offers only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development only: optional JSON array of test florists.
ROUTING_PARTNERS_JSON=

# Supplier payouts are independently OFF unless explicitly enabled.
ENABLE_SUPPLIER_PAYOUTS=false
PAYOUT_TICK_MS=30000

# Provider-agnostic payout gateway/proxy.
# It must expose POST /payouts and support idempotency.
PAYOUT_API_BASE_URL=
PAYOUT_API_KEY=
